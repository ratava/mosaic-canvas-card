    "lovelace",
    "custom-card",
    "energy",
    "dashboard"
  ],
  "author": "Brent Wesley",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.2.0",
    "vanilla-colorful": "^0.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "home-assistant-js-websocket": "^9.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
